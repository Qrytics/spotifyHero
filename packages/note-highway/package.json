{
  "name": "@spotifyhero/note-highway",
  "version": "0.0.1",
  "private": true,
  "description": "Canvas 2D note highway renderer for spotifyHero — swappable, renderer-agnostic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@spotifyhero/game-state": "workspace:*",
    "@spotifyhero/gameplay-core": "workspace:*",
    "@spotifyhero/shared-types": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
