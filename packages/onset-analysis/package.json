{
  "name": "@spotifyhero/onset-analysis",
  "version": "0.0.1",
  "private": true,
  "description": "Pure-DSP onset, tempo and pitch analysis: Float32Array in, BeatEvent[] out",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@spotifyhero/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
