# Copy to itch.env (gitignored) and fill in. Used by pnpm itch:push / pnpm itch:release
#
# ITCH_USER = your itch.io username (from https://YOURNAME.itch.io)
# ITCH_GAME = game slug in the URL https://YOURNAME.itch.io/GAME-SLUG

ITCH_USER=
ITCH_GAME=spotifyhero

# Optional: butler channel name. Defaults to the host platform's channel —
# "osx" on macOS, "windows" on Windows. itch works out which platform an upload
# is for from this name, so only override it with something still containing
# osx / windows / linux.
# ITCH_CHANNEL=osx

# Optional: print the butler command instead of running it.
# ITCH_DRY_RUN=1

# Optional: full path to the butler binary if not on PATH (same as BUTLER_PATH)
# BUTLER_PATH=/Users/you/.local/bin/butler
