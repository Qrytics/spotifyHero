{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spotifyHero",
  "version": "0.0.1",
  "identifier": "io.spotifyhero.app",
  "build": {
    "beforeDevCommand": "pnpm -w run build:packages && pnpm --filter overlay-ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -w run build:packages && pnpm --filter overlay-ui build",
    "frontendDist": "../../../apps/overlay-ui/dist"
  },
  "app": {
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
