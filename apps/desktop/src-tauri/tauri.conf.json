{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spotifyHero",
  "version": "0.0.1",
  "identifier": "io.spotifyhero.app",
  "build": {
    "beforeDevCommand": "pnpm --filter overlay-ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter overlay-ui build",
    "frontendDist": "../../../apps/overlay-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "spotifyHero",
        "width": 360,
        "height": 640,
        "minWidth": 200,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": true,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
