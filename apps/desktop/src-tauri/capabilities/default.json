{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Overlay window — IPC, shell (browser OAuth), store (tokens)",
  "windows": ["overlay"],
  "remote": {
    "urls": ["http://localhost:1420/*", "http://127.0.0.1:1420/*"]
  },
  "permissions": ["core:default", "shell:default", "store:default"]
}
