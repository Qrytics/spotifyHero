{
  "name": "overlay-ui",
  "version": "0.0.1",
  "private": true,
  "description": "React + PixiJS note highway and HUD for spotifyHero",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc -p tsconfig.json --noEmit",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.3.0",
    "@spotifyhero/audio-engine": "workspace:*",
    "@spotifyhero/chart-generator": "workspace:*",
    "@spotifyhero/gameplay-core": "workspace:*",
    "@spotifyhero/leaderboard-client": "workspace:*",
    "@spotifyhero/shared-types": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
